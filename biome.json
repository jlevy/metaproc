{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "files": {
    "includes": [
      "src/metaproc/metabrowser_plugin/plugin/**",
      "tests/dom/**",
      "!src/metaproc/metabrowser_plugin/plugin/elk.bundled.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noDescendingSpecificity": "off",
        "useBlockStatements": "error",
        "useTemplate": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/metaproc/metabrowser_plugin/plugin/domain_views.js",
        "src/metaproc/metabrowser_plugin/plugin/viz.js"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noInnerDeclarations": "off"
          },
          "suspicious": {
            "noRedeclare": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
