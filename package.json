{
  "name": "metaproc-devtools",
  "version": "0.0.0",
  "private": true,
  "description": "Pinned JavaScript toolchain for Metaproc plugin linting and type checking.",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.10.0 <12"
  },
  "scripts": {
    "check:browser": "biome ci --error-on-warnings --config-path=biome.json . && tsc --project tsconfig.json",
    "format:browser": "biome check --write --unsafe --config-path=biome.json .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/node": "24.13.3",
    "lefthook": "2.1.9",
    "typescript": "6.0.3"
  }
}
