{
  "_note": "Canonical pi-cli models.json for Vertex AI. Committed to the repo so cloud dispatches succeed from environments without a workstation-configured ~/.pi/agent/models.json. metaproc.cloud.gcp.batch_backend.build_pi_models_json reads this as a fallback and rewrites the project ID in baseUrl at dispatch time.",
  "_source": "The vertex-maas catalog is maintained from public Vertex AI model metadata. The google-vertex provider uses pi-mono's native `google-vertex` API so Gemini thought-signature round trips are preserved; see the adapter compatibility runbook.",
  "providers": {
    "vertex-maas": {
      "baseUrl": "https://aiplatform.googleapis.com/v1/projects/PROJECT_ID_PLACEHOLDER/locations/global/endpoints/openapi",
      "api": "openai-completions",
      "apiKey": "!sh -c 'if [ -n \"$METAPROC_PI_API_KEY\" ]; then printf \"%s\" \"$METAPROC_PI_API_KEY\"; else exec gcp-access-token.sh; fi'",
      "authHeader": true,
      "compat": {"supportsDeveloperRole": false},
      "models": [
        {"id": "zai-org/glm-5-maas", "name": "GLM-5 (Vertex AI MaaS)", "reasoning": true, "input": ["text"], "contextWindow": 200000, "maxTokens": 128000},
        {"id": "zai-org/glm-4.7-maas", "name": "GLM-4.7 (Vertex AI MaaS)", "reasoning": true, "input": ["text"], "contextWindow": 200000, "maxTokens": 128000},
        {"id": "moonshotai/kimi-k2-thinking-maas", "name": "Kimi K2 Thinking (Vertex AI MaaS)", "reasoning": true, "input": ["text"], "contextWindow": 262144, "maxTokens": 262144},
        {"id": "deepseek-ai/deepseek-v3.2-maas", "name": "DeepSeek V3.2 (Vertex AI MaaS)", "reasoning": true, "input": ["text"], "contextWindow": 163840, "maxTokens": 65536},
        {"id": "qwen/qwen3-235b-a22b-instruct-2507-maas", "name": "Qwen3 235B (Vertex AI MaaS)", "reasoning": true, "input": ["text"], "contextWindow": 262144, "maxTokens": 16384},
        {"id": "qwen/qwen3-coder-480b-a35b-instruct-maas", "name": "Qwen3 Coder 480B (Vertex AI MaaS)", "reasoning": true, "input": ["text"], "contextWindow": 262144, "maxTokens": 65536}
      ]
    },
    "google-vertex": {
      "_note": "Native Vertex metadata is reviewed against the model pages linked in metaproc.config.model_catalog. The gemini-3.1-pro-preview-customtools entry retains legacy capability values for compatibility; its Vertex endpoint and exact limits remain unverified and must not be inferred from the standard Pro entry.",
      "baseUrl": "https://{location}-aiplatform.googleapis.com",
      "api": "google-vertex",
      "apiKey": "gcp-vertex-credentials",
      "models": [
        {"id": "gemini-3.8-flash", "name": "Gemini 3.8 Flash (Vertex)", "reasoning": true, "input": ["text", "image"], "contextWindow": 1048576, "maxTokens": 65536},
        {"id": "gemini-3.7-flash", "name": "Gemini 3.7 Flash (Vertex)", "reasoning": true, "input": ["text", "image"], "contextWindow": 1048576, "maxTokens": 65536},
        {"id": "gemini-3.6-flash", "name": "Gemini 3.6 Flash (Vertex)", "reasoning": true, "input": ["text", "image"], "contextWindow": 1048576, "maxTokens": 65536},
        {"id": "gemini-3.5-flash-lite", "name": "Gemini 3.5 Flash-Lite (Vertex)", "reasoning": true, "input": ["text", "image"], "contextWindow": 1048576, "maxTokens": 65536},
        {"id": "gemini-3.5-flash", "name": "Gemini 3.5 Flash (Vertex)", "reasoning": true, "input": ["text", "image"], "contextWindow": 1048576, "maxTokens": 65536},
        {"id": "gemini-3.1-flash-lite", "name": "Gemini 3.1 Flash-Lite (Vertex)", "reasoning": true, "input": ["text", "image"], "contextWindow": 1048576, "maxTokens": 65536},
        {"id": "gemini-3-flash-preview", "name": "Gemini 3 Flash (preview, Vertex)", "reasoning": true, "input": ["text", "image"], "contextWindow": 1048576, "maxTokens": 65536},
        {"id": "gemini-3.1-pro-preview", "name": "Gemini 3.1 Pro (preview, Vertex)", "reasoning": true, "input": ["text", "image"], "contextWindow": 1048576, "maxTokens": 65536},
        {"id": "gemini-3.1-pro-preview-customtools", "name": "Gemini 3.1 Pro (preview, customtools, Vertex)", "reasoning": true, "input": ["text"], "contextWindow": 2097152, "maxTokens": 65536}
      ]
    },
    "openai": {
      "_note": "New Astra, Sol, Terra, and Luna entries use per-model Responses API overrides supported by the pinned Pi client. Existing entries retain the provider's Chat Completions default. Model names, review sources, and lifecycle evidence are maintained in metaproc.config.model_catalog; catalog inclusion does not establish account access or a live compatibility test.",
      "baseUrl": "https://api.openai.com/v1",
      "api": "openai-completions",
      "apiKey": "OPENAI_API_KEY",
      "models": [
        {"id": "gpt-6-astra", "name": "GPT-6 Astra", "api": "openai-responses", "reasoning": true, "input": ["text", "image"], "contextWindow": 1050000, "maxTokens": 128000},
        {"id": "gpt-5.6-sol", "name": "GPT-5.6 Sol", "api": "openai-responses", "reasoning": true, "input": ["text", "image"], "contextWindow": 1050000, "maxTokens": 128000},
        {"id": "gpt-5.6-terra", "name": "GPT-5.6 Terra", "api": "openai-responses", "reasoning": true, "input": ["text", "image"], "contextWindow": 1050000, "maxTokens": 128000},
        {"id": "gpt-5.6-luna", "name": "GPT-5.6 Luna", "api": "openai-responses", "reasoning": true, "input": ["text", "image"], "contextWindow": 1050000, "maxTokens": 128000},
        {"id": "gpt-5.5", "name": "GPT-5.5", "reasoning": true, "input": ["text", "image"], "contextWindow": 1000000, "maxTokens": 128000},
        {"id": "gpt-5.4-mini", "name": "GPT-5.4 Mini", "reasoning": true, "input": ["text", "image"], "contextWindow": 400000, "maxTokens": 128000},
        {"id": "gpt-5.4-nano", "name": "GPT-5.4 Nano", "reasoning": true, "input": ["text", "image"], "contextWindow": 400000, "maxTokens": 128000}
      ]
    },
    "deepseek": {
      "_note": "DeepSeek first-party API (V4 family). OpenAI-compatible /v1/chat/completions. V4 released 2026-04-24; both IDs support 1M context and dual mode (thinking / non-thinking) on the same model ID. The deepseek-chat / deepseek-reasoner V3.2 aliases retire 2026-07-24 and are no longer registered here — use deepseek-v4-flash / deepseek-v4-pro.",
      "baseUrl": "https://api.deepseek.com/v1",
      "api": "openai-completions",
      "apiKey": "DEEPSEEK_API_KEY",
      "models": [
        {"id": "deepseek-v4-pro", "name": "DeepSeek V4 Pro", "reasoning": true, "input": ["text"], "contextWindow": 1000000, "maxTokens": 384000},
        {"id": "deepseek-v4-flash", "name": "DeepSeek V4 Flash", "reasoning": true, "input": ["text"], "contextWindow": 1000000, "maxTokens": 384000}
      ]
    },
    "moonshot": {
      "_note": "Retained Moonshot OpenAI-compatible configuration. The current review did not establish the exact kimi-k2.6 ID in primary Moonshot documentation; verify account model discovery and tool-call compatibility before use. See metaproc.config.model_catalog for dated evidence and the separate Vertex MaaS lifecycle.",
      "baseUrl": "https://api.moonshot.ai/v1",
      "api": "openai-completions",
      "apiKey": "MOONSHOT_API_KEY",
      "models": [
        {"id": "kimi-k2.6", "name": "Kimi K2.6", "reasoning": true, "input": ["text", "image"], "contextWindow": 262144, "maxTokens": 65536}
      ]
    }
  }
