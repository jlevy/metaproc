# ─────────────────────────────────────────────────────────────
# .env.example — generated from the MetaprocEnv registry.
#
# DO NOT EDIT BY HAND. To regenerate after a registry change:
#   uv --config-file uv.toml run --frozen metaproc env --template > .env.example
# CI gates this file via tests/test_env_template.py.
#
# Copy to .env (gitignored) and replace placeholder values.
# metaproc auto-loads .env on CLI bootstrap, so every variable here is
# picked up by every `metaproc` command.
#
# Legend:
#   REAL      — real default for this project, copy as-is
#   SECRET    — illustration only, MUST be replaced with a real secret
#   TUNABLE   — sensible default, change only if your situation requires it
#   OPTIONAL  — commented out by default; uncomment and set if needed
# ─────────────────────────────────────────────────────────────

# TUNABLE — GCP project ID for Batch / Compute operations.
export METAPROC_GCP_PROJECT=<your-gcp-project-id>

# TUNABLE — Custom service account for Batch VMs. Required in practice — the
# default compute SA lacks Secret Manager access, so Batch jobs fail silently
# without it.
export METAPROC_GCP_SERVICE_ACCOUNT=<worker-sa>@<your-gcp-project-id>.iam.gserviceaccount.com

# TUNABLE — Docker image URI for the GCP Batch agent.
export METAPROC_GCP_CONTAINER_IMAGE=<region>-docker.pkg.dev/<your-gcp-project-id>/<your-repo>/agent:latest

# TUNABLE — GCP region for Batch jobs.
export METAPROC_GCP_REGION=us-central1

# TUNABLE — Filestore NFS server IP for shared run artifact storage.
export METAPROC_GCP_FILESTORE_SERVER=10.0.0.10

# TUNABLE — NFS share name on the Filestore instance.
export METAPROC_GCP_FILESTORE_SHARE=/<your-share-name>

# TUNABLE — Local mount point for the Filestore share on worker VMs.
export METAPROC_GCP_FILESTORE_MOUNT_PATH=/mnt/filestore

# TUNABLE — Runs directory on the Filestore mount, used by remote monitoring
# commands.
export METAPROC_GCP_FILESTORE_REMOTE_RUNS_DIR=/mnt/filestore/runs

# TUNABLE — Boot disk size (GB) for worker VMs.
export METAPROC_GCP_BOOT_DISK_GB=50

# TUNABLE — Max run duration (seconds) per Batch task.
export METAPROC_GCP_MAX_RUN_DURATION_S=28800

# TUNABLE — GCS bucket for run artifact sync and wheel / workspace uploads.
export METAPROC_GCS_BUCKET=<your-gcs-bucket>

# TUNABLE — Git repo URL that worker containers clone to obtain project code.
export METAPROC_REPO_URL=https://github.com/<your-org>/<your-repo>.git

# TUNABLE — Git branch workers check out. Typically your current branch or
# `main`.
export METAPROC_RUN_BRANCH=main

# TUNABLE — Repo-relative path containing Metaproc's pyproject.toml for editable
# remote installs.
export METAPROC_REPO_PACKAGE_PATH=.

# OPTIONAL — GCS path to a prebuilt metaproc wheel. When set, workers install
# from the wheel instead of cloning.
# export METAPROC_WHEEL_GCS=gs://<your-gcs-bucket>/wheels/metaproc-0.1.0-py3-none-any.whl

# OPTIONAL — GCS path to a workspace tarball for the active workflow plugin.
# When set, workers extract and install the plugin from the tarball instead of
# cloning.
# export METAPROC_WORKSPACE_GCS=gs://<your-gcs-bucket>/workspaces/<your-plugin>.tar.gz

# OPTIONAL — GCE machine type for orchestrator-launched worker VMs.
# export METAPROC_MACHINE_TYPE=e2-standard-4

# OPTIONAL — GCE machine type override for `run-process --backend gcp-worker`
# fan-out workers. Distinct from METAPROC_MACHINE_TYPE, which scopes the
# orchestrator-launched worker VMs.
# export METAPROC_GCP_MACHINE_TYPE=e2-highmem-8

# OPTIONAL — SSH gateway host for `metaproc gcp remote` commands.
# export METAPROC_GATEWAY_HOST=<your-gateway-host>

# SECRET — Base64-encoded service-account JSON for GCP auth. Alternative to ADC.
export GCP_CREDENTIALS_BASE64=REPLACE_WITH_BASE64_ENCODED_SERVICE_ACCOUNT_JSON

# SECRET — GitHub personal access token for gh-backed workflows.
export GH_TOKEN=REPLACE_WITH_GITHUB_TOKEN

# REAL — When truthy, the `gh` CLI skips interactive prompts.
export GH_PROMPT_DISABLED=1

# SECRET — Perplexity API key used by the web search provider.
export PERPLEXITY_API_KEY=your_api_key_here

# SECRET — Anthropic API key for direct Claude adapter use.
export ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY

# SECRET — OpenAI API key used by the PI CLI adapter and the codex-cli adapter
# (Vehicle A, API-key mode).
export OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY

# SECRET — DeepSeek API key for the pi-cli `deepseek` provider (DeepSeek V4
# family, direct API).
export DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_API_KEY

# SECRET — Moonshot API key for the pi-cli `moonshot` provider (Kimi K2.6,
# direct API).
export MOONSHOT_API_KEY=REPLACE_WITH_MOONSHOT_API_KEY

# SECRET — Gemini API key for direct (non-Vertex) Gemini adapter use.
export GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY

# SECRET — Google API key for direct Gemini adapter fallback.
export GOOGLE_API_KEY=REPLACE_WITH_GOOGLE_API_KEY

# OPTIONAL — GCP Secret Manager ref that provides GH_TOKEN to Batch workers.
# export METAPROC_GCP_SECRET_GH_TOKEN=projects/<your-gcp-project-id>/secrets/<secret-name>/versions/latest

# SECRET — Claude Code OAuth credential blob injected into Batch workers from
# Secret Manager.
export CLAUDE_CODE_CREDS_JSON=REPLACE_WITH_CLAUDE_CODE_CREDS_JSON

# SECRET — Codex CLI ChatGPT-OAuth credential blob (contents of
# ~/.codex/auth.json) injected into Batch workers from Secret Manager. Vehicle B
# only — API-key mode arrives via OPENAI_API_KEY instead.
export CODEX_CREDS_JSON=REPLACE_WITH_CODEX_CREDS_JSON

# TUNABLE — Default per-step max concurrency. Edit here when Vertex MaaS DSQ
# quota changes.
export METAPROC_DEFAULT_MAX_CONCURRENCY=25

# TUNABLE — Default number of workers per step when not specified per-step.
export METAPROC_DEFAULT_NUM_WORKERS=1

# OPTIONAL — Runtime run-artifact parent directory passed to Metaproc. Required
# at workflow launch time; set explicitly or derive from workflow run settings.
# export RUNS_DIR=/absolute/path/to/runs

# OPTIONAL — metabrowser plugin parents to scan, os.pathsep-separated. Each
# subdirectory containing manifest.toml is loaded. Built-ins and Python entry-
# point plugins (e.g. metaproc's metabrowser_plugin subpackage) load
# automatically; this is the opt-in surface for ad-hoc / workspace-local
# plugins. Auto-discovery from the served root is intentionally NOT a source.
# export METABROWSER_PLUGINS_DIRS=/path/to/my-plugins:/path/to/team-plugins
